{
  "flow_name": "Agentic Action Assurance Flow",
  "platform_rule": "Cloud platforms execute AI agents. COBIT-Chain evaluates whether AI-assisted actions are operationally trustworthy before they affect regulated systems.",
  "positioning": "This strengthens Agent Passport, Tool Call Evidence Ledger, AI Output Clearance, Operational Trust, Evidence Vault, Knowledge Integrity, and Decision Confidence. It is not a separate Agentic AI governance product.",
  "workflow": [
    {
      "stage_id": "intent",
      "stage_name": "Intent",
      "engineering_question": "What action is the AI agent trying to perform, and why?",
      "assurance_role": "Capture the action objective, requested target, business purpose, initiating user, and operational impact before any execution.",
      "mapped_capabilities": ["Decision Confidence", "AI Output Clearance", "Evidence Vault"],
      "required_evidence": ["Action objective", "Requested target", "Business purpose", "Initiating user", "Operational impact statement"],
      "gaps_to_watch": ["Intent unclear", "No business purpose", "No target object", "No operational impact statement"],
      "readiness_score": 82
    },
    {
      "stage_id": "authority",
      "stage_name": "Authority",
      "engineering_question": "Does the agent have delegated authority to perform this action?",
      "assurance_role": "Validate agent identity, delegated authority, role boundary, approval route, and prohibited-action constraints.",
      "mapped_capabilities": ["Agent Passport", "AccessTrust", "Operational Trust"],
      "required_evidence": ["Agent ID", "Agent passport", "Delegated authority record", "Allowed action list", "Blocked action list"],
      "gaps_to_watch": ["No agent passport", "Authority not delegated", "Allowed actions not defined", "Blocked actions not defined"],
      "readiness_score": 76
    },
    {
      "stage_id": "context",
      "stage_name": "Context",
      "engineering_question": "Is the operational context valid for this action now?",
      "assurance_role": "Validate context of use, workflow state, target system state, regulated impact, and timing constraints.",
      "mapped_capabilities": ["Operational Trust", "Knowledge Integrity", "Decision Confidence"],
      "required_evidence": ["Context of use", "Workflow state", "Target system state", "Regulated impact", "Timing constraint"],
      "gaps_to_watch": ["Context not validated", "Workflow state unknown", "Target state unknown", "Regulated impact unclear"],
      "readiness_score": 78
    },
    {
      "stage_id": "policy_risk_evaluation",
      "stage_name": "Policy and Risk Evaluation",
      "engineering_question": "Does policy, risk, and operational readiness allow this action?",
      "assurance_role": "Evaluate policy compliance, change-control impact, GMP or regulated impact, business risk, and readiness blockers.",
      "mapped_capabilities": ["AI ChangeControlTrust", "Operational Trust", "Evidence Vault"],
      "required_evidence": ["Policy rule", "Risk rating", "Change-control impact", "Readiness status", "Exception record"],
      "gaps_to_watch": ["Policy not checked", "Risk not assessed", "Change impact unknown", "No exception route"],
      "readiness_score": 74
    },
    {
      "stage_id": "human_approval",
      "stage_name": "Human Approval",
      "engineering_question": "Is human approval required before the action executes?",
      "assurance_role": "Determine approval requirement, named reviewer, approval gate, escalation path, and accountability before execution.",
      "mapped_capabilities": ["Decision Confidence", "AI ChangeControlTrust", "Operational Trust"],
      "required_evidence": ["Approval requirement", "Named reviewer", "Approval decision", "Escalation path", "Accountability record"],
      "gaps_to_watch": ["Approval requirement unclear", "No named reviewer", "No approval decision", "No escalation path"],
      "readiness_score": 81
    },
    {
      "stage_id": "execution",
      "stage_name": "Execution",
      "engineering_question": "Was the action executed only through a governed tool boundary?",
      "assurance_role": "Require MCP governance, tool identity, tool schema, action boundary, input-output record, and runtime control.",
      "mapped_capabilities": ["MCP Governance", "Tool Call Evidence Ledger", "Agent Passport"],
      "required_evidence": ["MCP server", "Tool ID", "Tool schema", "Tool call ID", "Input-output record", "Runtime control"],
      "gaps_to_watch": ["Tool not governed", "No tool schema", "No tool-call ID", "No runtime control"],
      "readiness_score": 73
    },
    {
      "stage_id": "state_verification",
      "stage_name": "State Verification",
      "engineering_question": "Did the target system reach the expected state after the action?",
      "assurance_role": "Verify target state before and after execution, detect unexpected changes, and confirm rollback or remediation path.",
      "mapped_capabilities": ["Operational Trust", "Observability", "Evidence Vault"],
      "required_evidence": ["Pre-action state", "Post-action state", "Expected state", "Verification result", "Rollback path"],
      "gaps_to_watch": ["No pre-action state", "No post-action state", "Expected state unclear", "No rollback path"],
      "readiness_score": 75
    },
    {
      "stage_id": "evidence_recording",
      "stage_name": "Evidence Recording",
      "engineering_question": "Can the action be replayed with evidence?",
      "assurance_role": "Bind intent, authority, context, risk, approval, tool call, execution result, and state verification into one evidence package.",
      "mapped_capabilities": ["Evidence Vault", "Tool Call Evidence Ledger", "Decision Confidence"],
      "required_evidence": ["Evidence package ID", "Trace ID", "Tool call record", "Approval record", "State verification record"],
      "gaps_to_watch": ["No evidence package", "No trace ID", "No tool call record", "No state verification record"],
      "readiness_score": 79
    },
    {
      "stage_id": "continuous_assurance",
      "stage_name": "Continuous Assurance",
      "engineering_question": "Does the action remain trustworthy over time?",
      "assurance_role": "Monitor downstream effects, exceptions, incidents, outcome metrics, trust score change, and accountability feedback.",
      "mapped_capabilities": ["Operational Trust Twin", "Observability", "AI ChangeControlTrust"],
      "required_evidence": ["Outcome metric", "Exception signal", "Incident signal", "Trust score change", "Accountability feedback"],
      "gaps_to_watch": ["No outcome metric", "No exception signal", "No incident monitoring", "No feedback loop"],
      "readiness_score": 77
    }
  ],
